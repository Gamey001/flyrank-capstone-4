# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored — never commit real keys.
#   cp .env.example .env
# The defaults below run the whole system with NO API key and NO network.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- database --------------------------------------------------------------
# Postgres (docker compose sets this for you):
#   DATABASE_URL=postgresql+psycopg2://flyrank:flyrank@db:5432/flyrank
# SQLite keeps a local run dependency-free:
DATABASE_URL=sqlite+pysqlite:///./flyrank.sqlite3
DEFAULT_TENANT=demo

# --- corpus ----------------------------------------------------------------
IMAGES_DIR=data/images
CORPUS_MANIFEST=data/corpus/manifest.json

# --- AI providers ----------------------------------------------------------
# stub   = deterministic offline fixtures (no key, no network) — the default
# gemini = Gemini Flash free tier (Google account, no credit card)
# ollama = fully local models via `ollama serve`
VISION_PROVIDER=stub
EMBEDDING_PROVIDER=stub

# Get a free key at https://aistudio.google.com/apikey (no credit card).
GEMINI_API_KEY=your-key-here
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=all-minilm

AI_REQUEST_TIMEOUT_S=60

# --- mismatch guard --------------------------------------------------------
# Tuned against data/seed/eval_set.json — see `python -m scripts.tune_thresholds`.
SIMILARITY_THRESHOLD=0.62
MIN_VISION_CONFIDENCE=0.55
LOW_CONFIDENCE_THRESHOLD=0.70
AMBIGUITY_MARGIN=0.03

# --- background jobs -------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_S=0.5
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_S=0.5
JOB_BACKOFF_MAX_S=30
# Optional: POST job-failure alerts here as well as logging them.
ALERT_WEBHOOK_URL=

# --- cost control ----------------------------------------------------------
# The free tier bills $0; calls are priced at the published paid rate anyway so
# the ledger is meaningful and the budget guard is genuinely exercised.
AI_DAILY_BUDGET_USD=1.0
VISION_COST_PER_CALL_USD=0.0002
EMBEDDING_COST_PER_1K_TOKENS_USD=0.000025
